# ---- Login (required: the app refuses all access until both are set) ----
# Generate both with:  npm run hash-password
ADMIN_PASSWORD_HASH=scrypt:<salt hex>:<hash hex>
SESSION_SECRET=<64 hex chars>
# How long a login lasts, in days. Default 7.
# SESSION_DAYS=7

# ---- Databases ----
# Add connections in the app (sidebar -> "+ Add"). They're saved in dbdesk's
# own Postgres database, in a table it creates (dbdesk_connections). Each
# connection is stored as one AES-256-GCM encrypted blob, so nothing in it
# (name, host, user, password) is readable from the database alone.
DBDESK_DATABASE_URL=postgres://dbdesk_app:password@localhost:5432/dbdesk
# 32 random bytes, base64:  openssl rand -base64 32
# Keep a copy in your password manager: lose it and saved connections are unreadable.
DBDESK_ENCRYPTION_KEY=<base64 key>
# Key rotation: bump the version, set the new key above, list the old one(s)
# here as version:key. Rows are re-encrypted on the next read.
# DBDESK_ENCRYPTION_KEY_VERSION=2
# DBDESK_OLD_ENCRYPTION_KEYS=1:<old base64 key>

# Optional: connections defined in env show up read-only next to saved ones.
# One server, every database on it is listed:
# DATABASE_URL=postgres://postgres:password@localhost:5432/postgres
# Several servers (overrides DATABASE_URL). JSON array, one line:
# DATABASE_SERVERS=[{"name":"main","url":"postgres://postgres:pw@abc123:5432/postgres"},{"name":"other","url":"postgres://postgres:pw@def456:5432/postgres"}]

# Kill SQL-tab queries that run longer than this (ms). Default 60000.
# STATEMENT_TIMEOUT_MS=60000
